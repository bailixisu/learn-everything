---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
const title = Array.isArray(pageTitle) ? pageTitle[0] : pageTitle;
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pt-8 pb-8 sm:pt-10", className]}
>
  <header class="border-border/80 mb-8 border-b pb-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
    {
      pageDesc && (
        <p class="text-muted-foreground mt-3 max-w-2xl text-base leading-7 sm:text-lg">
          {pageDesc}
        </p>
      )
    }
  </header>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
