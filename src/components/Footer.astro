---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border/80 flex flex-col items-center gap-4 border-t py-8 sm:flex-row sm:justify-between sm:py-6"
  >
    <div
      class="flex flex-col items-center gap-1 text-center sm:items-start sm:text-start"
    >
      <p class="text-muted-foreground max-w-sm text-sm leading-relaxed">
        {t.footer.tagline}
      </p>
      <div
        class="text-muted-foreground flex flex-col items-center text-xs sm:flex-row sm:gap-2 sm:text-sm"
      >
        <span
          >{t.footer.copyright} &#169; {currentYear} {config.site.author}</span
        >
        <span class="hidden sm:inline" aria-hidden="true">·</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
    </div>
    <Socials />
  </div>
</footer>
