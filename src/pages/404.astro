---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 flex-col items-center justify-center py-16"
  >
    <div class="surface-card mb-14 max-w-md px-8 py-12 text-center">
      <p class="text-accent text-sm font-semibold tracking-[0.2em] uppercase">
        404
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.notFound.title}
      </h1>
      <p class="text-muted-foreground mt-4 leading-7">{t.notFound.message}</p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="text-accent border-border hover:bg-muted/40 mt-8 inline-flex rounded-full border px-4 py-2 text-sm font-medium transition-colors"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
