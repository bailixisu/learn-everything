---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const schemes = [
  {
    id: "system",
    name: "当前方案",
    label: "系统黑体",
    description: "苹方优先，简洁、稳定、加载最快",
  },
  {
    id: "tech",
    name: "方案一",
    label: "思源黑体",
    description: "现代科技感，标题和正文统一清晰",
  },
  {
    id: "editorial",
    name: "方案二 · 推荐",
    label: "黑体标题 + 宋体正文",
    description: "像技术杂志，适合图文并茂的长文章",
  },
  {
    id: "garden",
    name: "方案三",
    label: "全站霞鹜文楷",
    description: "温暖、有个人笔记和数字花园气质",
  },
  {
    id: "title-wenkai",
    name: "方案四",
    label: "文楷标题 + 黑体正文",
    description: "标题有个性，正文保持现代和清晰",
  },
  {
    id: "body-wenkai",
    name: "方案五",
    label: "黑体标题 + 文楷正文",
    description: "结构醒目，阅读过程更像个人手记",
  },
  {
    id: "smiley",
    name: "创意 A · 真斜体",
    label: "得意黑标题 + 黑体正文",
    description: "中文标题自然前倾，活泼、锐利、有未来感",
  },
  {
    id: "xiaowei",
    name: "创意 B",
    label: "小薇体标题 + 宋体正文",
    description: "纤细复古，像独立杂志和人文技术刊物",
  },
  {
    id: "brush",
    name: "创意 C",
    label: "毛笔标题 + 黑体正文",
    description: "书写感最强，适合栏目题签和重点标题",
  },
];

const palettes = [
  {
    id: "midnight",
    name: "午夜青绿",
    note: "接近当前",
    colors: ["#101715", "#e9f3ee", "#77c7af", "#31423b"],
  },
  {
    id: "ink",
    name: "宣纸青墨",
    note: "自然耐读",
    colors: ["#fbfaf5", "#252722", "#357266", "#e4e3dc"],
  },
  {
    id: "indigo",
    name: "雾紫靛蓝",
    note: "科技创意",
    colors: ["#f8f7ff", "#28243a", "#6d5bd0", "#ded9f3"],
  },
  {
    id: "amber",
    name: "琥珀纸张",
    note: "温暖编辑感",
    colors: ["#fff9ed", "#352c22", "#c06932", "#eadbc4"],
  },
  {
    id: "rose",
    name: "灰粉玫瑰",
    note: "柔和克制",
    colors: ["#fff8f8", "#382b30", "#b65f78", "#ecd8df"],
  },
  {
    id: "ocean",
    name: "海盐蓝",
    note: "清爽理性",
    colors: ["#f4fafc", "#172d36", "#167f98", "#cfe3e9"],
  },
];
---

<Layout
  title="字体方案预览 · Learn Everything"
  description="比较 Learn Everything 博客的中文字体组合。"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <link
    slot="head"
    rel="preconnect"
    href="https://cdn.jsdelivr.net"
    crossorigin="anonymous"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-sans-sc@5.3.0/index.css"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fontsource-variable/noto-serif-sc@5.3.0/index.css"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-regular.css"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jetbrains-mono@5.3.0/index.css"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fontsource/zcool-xiaowei@5.3.0/index.css"
  />
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/@fontsource/ma-shan-zheng@5.3.1/index.css"
  />

  <Header />
  <main id="main-content" class="app-layout py-10 sm:py-14">
    <header class="border-border mb-8 border-b pb-8">
      <p
        class="text-accent mb-3 text-sm font-semibold tracking-[0.2em] uppercase"
      >
        Typography Lab
      </p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        中文字体方案预览
      </h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
        自由组合字体与配色，下方会使用相同内容展示标题、正文、引用、强调和代码。这个页面不会改变博客当前样式。
      </p>
      <p
        class="border-accent/40 bg-accent/8 text-muted-foreground mt-5 max-w-2xl rounded-lg border px-4 py-3 text-sm leading-6"
      >
        中文很少有真正的 Italic
        字形。“得意黑”是专门设计的中文斜体；文楷和毛笔体则通过书写动势营造类似效果，而不是机械倾斜。
      </p>
    </header>

    <section aria-labelledby="scheme-title">
      <h2 id="scheme-title" class="mb-4 text-xl font-semibold">选择方案</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          schemes.map((scheme, index) => (
            <button
              type="button"
              class:list={[
                "font-option border-border hover:border-accent rounded-xl border p-4 text-left transition",
                { selected: index === 2 },
              ]}
              data-scheme={scheme.id}
              aria-pressed={index === 2 ? "true" : "false"}
            >
              <span class="text-accent block text-xs font-semibold tracking-wider uppercase">
                {scheme.name}
              </span>
              <strong class="mt-1 block text-lg">{scheme.label}</strong>
              <span class="text-muted-foreground mt-1 block text-sm leading-6">
                {scheme.description}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="mt-10" aria-labelledby="palette-title">
      <h2 id="palette-title" class="mb-4 text-xl font-semibold">选择配色</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          palettes.map((palette, index) => (
            <button
              type="button"
              class:list={[
                "palette-option border-border hover:border-accent rounded-xl border p-4 text-left transition",
                { selected: index === 0 },
              ]}
              data-palette={palette.id}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="flex items-start justify-between gap-3">
                <strong>{palette.name}</strong>
                <span class="text-muted-foreground text-xs">
                  {palette.note}
                </span>
              </span>
              <span class="mt-3 flex gap-2" aria-hidden="true">
                {palette.colors.map(color => (
                  <span
                    class="palette-swatch"
                    style={`--swatch-color: ${color}`}
                  />
                ))}
              </span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="mt-10" aria-labelledby="preview-title">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h2 id="preview-title" class="text-xl font-semibold">实际文章效果</h2>
        <div class="flex flex-wrap gap-2">
          <span
            id="active-scheme"
            class="bg-accent/10 text-accent rounded-full px-3 py-1 text-sm font-medium"
          >
            方案二 · 黑体标题 + 宋体正文
          </span>
          <span
            id="active-palette"
            class="border-border rounded-full border px-3 py-1 text-sm font-medium"
          >
            午夜青绿
          </span>
        </div>
      </div>

      <article
        id="font-stage"
        data-font-scheme="editorial"
        data-palette="midnight"
        class="overflow-hidden rounded-2xl border shadow-sm"
      >
        <div class="preview-header border-b px-6 py-8 sm:px-10 sm:py-12">
          <p class="preview-kicker">AGENT · ARCHITECTURE</p>
          <h1 class="preview-heading">
            ReAct、Plan-and-Execute 与 Multi-Agent
          </h1>
          <p class="preview-description">
            从反馈控制、显式规划和组织协作三个维度，理解 Agent 架构的内核差异。
          </p>
          <div class="preview-meta">
            <span>2026 年 9 月 11 日</span>
            <span>·</span>
            <span>约 12 分钟阅读</span>
          </div>
        </div>

        <div class="preview-body px-6 py-8 sm:px-10 sm:py-12">
          <p class="preview-lead">
            如果一个 Agent
            已经能够使用工具，为什么还需要规划器和多个协作角色？关键不在于组件数量，而在于系统究竟要解决哪一种失败。
          </p>

          <p>
            <strong>ReAct 优化适应性</strong>，让模型根据最新观察决定下一步；
            <strong>Plan-and-Execute 优化全局结构</strong
            >，避免长任务遗漏关键阶段； Multi-Agent
            则负责拆分上下文、权限与专业责任。
          </p>

          <blockquote>
            好的架构不是使用最多的 Agent，而是用最小复杂度解决真实问题。
          </blockquote>

          <h2>核心问题：什么时候增加复杂度？</h2>
          <p>
            应该从失败模式出发，而不是从流行术语出发。当环境变化频繁时缩短反馈环；当任务容易漏步骤时引入显式计划；只有出现真实的分工、隔离或并行需求时，才需要多个
            Agent。
          </p>

          <ul>
            <li>环境反馈是否会改变下一步？</li>
            <li>是否存在清晰、可验证的阶段？</li>
            <li>是否真的需要独立上下文或权限？</li>
          </ul>

          <p>
            其中最值得记住的是：<mark>复杂度必须通过可测量的收益来证明</mark
            >，而不是通过更复杂的架构图来证明。
          </p>

          <pre><code>if environment_is_dynamic:
    use("ReAct")
elif long_task_misses_steps:
    use("Plan-and-Execute")
else:
    keep_it_simple()</code></pre>
        </div>
      </article>
    </section>

    <section class="mt-12" aria-labelledby="quick-compare-title">
      <h2 id="quick-compare-title" class="mb-4 text-xl font-semibold">
        标题快速对比
      </h2>
      <div class="space-y-3">
        {
          schemes.map(scheme => (
            <div
              class={`mini-sample border-border rounded-xl border p-5 scheme-${scheme.id}`}
            >
              <span class="text-muted-foreground text-xs">{scheme.label}</span>
              <p class="mini-heading mt-2">Workflow 管过程，Skill 管能力</p>
              <p class="mini-body mt-2">
                一个回答“什么时候做什么”，另一个回答“这件事应该怎样做好”。
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const schemeNames: Record<string, string> = {
    system: "当前方案 · 系统黑体",
    tech: "方案一 · 思源黑体",
    editorial: "方案二 · 黑体标题 + 宋体正文",
    garden: "方案三 · 全站霞鹜文楷",
    "title-wenkai": "方案四 · 文楷标题 + 黑体正文",
    "body-wenkai": "方案五 · 黑体标题 + 文楷正文",
    smiley: "创意 A · 得意黑斜体标题",
    xiaowei: "创意 B · 小薇体标题",
    brush: "创意 C · 毛笔标题",
  };

  const paletteNames: Record<string, string> = {
    midnight: "午夜青绿",
    ink: "宣纸青墨",
    indigo: "雾紫靛蓝",
    amber: "琥珀纸张",
    rose: "灰粉玫瑰",
    ocean: "海盐蓝",
  };

  function setupFontPreview() {
    const stage = document.querySelector<HTMLElement>("#font-stage");
    const fontLabel = document.querySelector<HTMLElement>("#active-scheme");
    const paletteLabel = document.querySelector<HTMLElement>("#active-palette");
    const fontOptions =
      document.querySelectorAll<HTMLButtonElement>(".font-option");
    const paletteOptions =
      document.querySelectorAll<HTMLButtonElement>(".palette-option");
    if (!stage || !fontLabel || !paletteLabel) return;

    fontOptions.forEach(option => {
      option.addEventListener("click", () => {
        const scheme = option.dataset.scheme ?? "editorial";
        stage.dataset.fontScheme = scheme;
        fontLabel.textContent = schemeNames[scheme] ?? scheme;
        fontOptions.forEach(item => {
          const selected = item === option;
          item.classList.toggle("selected", selected);
          item.setAttribute("aria-pressed", String(selected));
        });
      });
    });

    paletteOptions.forEach(option => {
      option.addEventListener("click", () => {
        const palette = option.dataset.palette ?? "midnight";
        stage.dataset.palette = palette;
        paletteLabel.textContent = paletteNames[palette] ?? palette;
        paletteOptions.forEach(item => {
          const selected = item === option;
          item.classList.toggle("selected", selected);
          item.setAttribute("aria-pressed", String(selected));
        });
      });
    });
  }

  setupFontPreview();
  document.addEventListener("astro:after-swap", setupFontPreview);
</script>

<style>
  @font-face {
    font-family: "Smiley Sans";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("https://cdn.jsdelivr.net/npm/@fontpkg/smiley-sans@2.0.4/SmileySans-Oblique.otf.woff2")
      format("woff2");
  }

  .font-option.selected,
  .palette-option.selected {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .palette-swatch {
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgb(128 128 128 / 25%);
    border-radius: 999px;
    background: var(--swatch-color);
  }

  #font-stage,
  .mini-sample {
    --preview-heading: "Noto Sans SC Variable", "PingFang SC", sans-serif;
    --preview-body: "Noto Serif SC Variable", "Songti SC", serif;
    --preview-code: "JetBrains Mono Variable", "SFMono-Regular", monospace;
  }

  #font-stage {
    --sample-bg: #101715;
    --sample-text: #e9f3ee;
    --sample-accent: #77c7af;
    --sample-muted: #aabbb4;
    --sample-border: #31423b;
    --sample-code: #1e2b27;
    border-color: var(--sample-border);
    background: var(--sample-bg);
    color: var(--sample-text);
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  #font-stage[data-palette="ink"] {
    --sample-bg: #fbfaf5;
    --sample-text: #252722;
    --sample-accent: #357266;
    --sample-muted: #667069;
    --sample-border: #e4e3dc;
    --sample-code: #eef0eb;
  }

  #font-stage[data-palette="indigo"] {
    --sample-bg: #f8f7ff;
    --sample-text: #28243a;
    --sample-accent: #6d5bd0;
    --sample-muted: #6c6880;
    --sample-border: #ded9f3;
    --sample-code: #eeebfa;
  }

  #font-stage[data-palette="amber"] {
    --sample-bg: #fff9ed;
    --sample-text: #352c22;
    --sample-accent: #c06932;
    --sample-muted: #746556;
    --sample-border: #eadbc4;
    --sample-code: #f4ead9;
  }

  #font-stage[data-palette="rose"] {
    --sample-bg: #fff8f8;
    --sample-text: #382b30;
    --sample-accent: #b65f78;
    --sample-muted: #7a6870;
    --sample-border: #ecd8df;
    --sample-code: #f7e8ed;
  }

  #font-stage[data-palette="ocean"] {
    --sample-bg: #f4fafc;
    --sample-text: #172d36;
    --sample-accent: #167f98;
    --sample-muted: #5c727b;
    --sample-border: #cfe3e9;
    --sample-code: #e2f0f4;
  }

  .preview-header {
    border-color: var(--sample-border);
  }

  [data-font-scheme="system"],
  .scheme-system {
    --preview-heading: "PingFang SC", "Microsoft YaHei", sans-serif;
    --preview-body: "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  [data-font-scheme="tech"],
  .scheme-tech {
    --preview-heading: "Noto Sans SC Variable", "PingFang SC", sans-serif;
    --preview-body: "Noto Sans SC Variable", "PingFang SC", sans-serif;
  }

  [data-font-scheme="editorial"],
  .scheme-editorial {
    --preview-heading: "Noto Sans SC Variable", "PingFang SC", sans-serif;
    --preview-body: "Noto Serif SC Variable", "Songti SC", serif;
  }

  [data-font-scheme="garden"],
  .scheme-garden {
    --preview-heading: "LXGW WenKai", "Kaiti SC", serif;
    --preview-body: "LXGW WenKai", "Kaiti SC", serif;
  }

  [data-font-scheme="title-wenkai"],
  .scheme-title-wenkai {
    --preview-heading: "LXGW WenKai", "Kaiti SC", serif;
    --preview-body: "Noto Sans SC Variable", "PingFang SC", sans-serif;
  }

  [data-font-scheme="body-wenkai"],
  .scheme-body-wenkai {
    --preview-heading: "Noto Sans SC Variable", "PingFang SC", sans-serif;
    --preview-body: "LXGW WenKai", "Kaiti SC", serif;
  }

  [data-font-scheme="smiley"],
  .scheme-smiley {
    --preview-heading: "Smiley Sans", "Noto Sans SC Variable", sans-serif;
    --preview-body: "Noto Sans SC Variable", "PingFang SC", sans-serif;
  }

  [data-font-scheme="xiaowei"],
  .scheme-xiaowei {
    --preview-heading: "ZCOOL XiaoWei", "Noto Serif SC Variable", serif;
    --preview-body: "Noto Serif SC Variable", "Songti SC", serif;
  }

  [data-font-scheme="brush"],
  .scheme-brush {
    --preview-heading: "Ma Shan Zheng", "Kaiti SC", cursive;
    --preview-body: "Noto Sans SC Variable", "PingFang SC", sans-serif;
  }

  .preview-kicker {
    color: var(--sample-accent);
    font-family: var(--preview-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .preview-heading,
  .mini-heading {
    font-family: var(--preview-heading);
  }

  .preview-heading {
    max-width: 42rem;
    margin-top: 1rem;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  .preview-description {
    max-width: 42rem;
    margin-top: 1.25rem;
    color: var(--sample-muted);
    font-family: var(--preview-body);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .preview-meta {
    display: flex;
    gap: 0.65rem;
    margin-top: 1.25rem;
    color: var(--sample-muted);
    font-family: var(--preview-heading);
    font-size: 0.85rem;
  }

  .preview-body,
  .mini-body {
    font-family: var(--preview-body);
  }

  .preview-body {
    font-size: 1.05rem;
    line-height: 1.95;
  }

  .preview-body > * + * {
    margin-top: 1.4rem;
  }

  .preview-lead {
    font-size: 1.18rem;
    line-height: 1.9;
  }

  .preview-body h2 {
    margin-top: 2.4rem;
    font-family: var(--preview-heading);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .preview-body blockquote {
    border-inline-start: 4px solid var(--sample-accent);
    padding: 0.75rem 0 0.75rem 1.25rem;
    color: var(--sample-muted);
    font-size: 1.12rem;
  }

  .preview-body ul {
    padding-inline-start: 1.4rem;
    list-style: disc;
  }

  .preview-body li::marker {
    color: var(--sample-accent);
  }

  .preview-body mark {
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--sample-accent) 22%, transparent);
    padding: 0.1rem 0.25rem;
    color: var(--sample-text);
  }

  .preview-body pre {
    overflow-x: auto;
    border: 1px solid var(--sample-border);
    border-radius: 0.75rem;
    background: var(--sample-code);
    padding: 1.25rem;
    font-family: var(--preview-code);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .mini-heading {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .mini-body {
    color: var(--muted-foreground);
    line-height: 1.8;
  }
</style>
