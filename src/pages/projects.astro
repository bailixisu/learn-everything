---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const projects = [
  {
    title: "Learn Everything",
    description:
      "一个使用 Astro 和 Markdown 构建的个人数字花园，用于沉淀学习、项目与思考。",
    tags: ["Astro", "Markdown", "数字花园"],
    href: "https://github.com/bailixisu/learn-everything",
    status: "持续更新",
  },
  {
    title: "下一个项目",
    description:
      "这里将展示正在实践的项目，包括它解决的问题、技术选择和阶段性成果。",
    tags: ["Coming soon"],
    href: "#",
    status: "等待记录",
  },
];
---

<Layout
  title="项目 · Learn Everything"
  description="bailixisu 的项目实践与作品。"
>
  <Header />
  <main id="main-content" class="app-layout py-10 sm:py-14">
    <header class="border-border mb-10 border-b pb-8">
      <p
        class="text-accent mb-3 text-sm font-semibold tracking-[0.2em] uppercase"
      >
        Build in public
      </p>
      <h1 class="text-4xl font-bold tracking-tight">项目</h1>
      <p class="text-muted-foreground mt-4 max-w-2xl text-lg leading-8">
        不只展示结果，也记录问题、选择、过程和复盘。
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2">
      {
        projects.map(project => (
          <article class="border-border bg-muted/20 rounded-xl border p-6 transition-transform hover:-translate-y-1">
            <div class="mb-4 flex items-start justify-between gap-4">
              <h2 class="text-xl font-semibold">{project.title}</h2>
              <span class="text-accent bg-accent/10 shrink-0 rounded-full px-2.5 py-1 text-xs font-medium">
                {project.status}
              </span>
            </div>
            <p class="text-muted-foreground min-h-20 leading-7">
              {project.description}
            </p>
            <ul class="my-5 flex flex-wrap gap-2" aria-label="技术标签">
              {project.tags.map(tag => (
                <li class="border-border rounded-md border px-2 py-1 text-xs">
                  {tag}
                </li>
              ))}
            </ul>
            {project.href !== "#" && (
              <a
                class="text-accent font-medium underline decoration-dashed underline-offset-4"
                href={project.href}
                target="_blank"
              >
                查看项目 →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
