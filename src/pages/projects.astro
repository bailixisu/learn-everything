---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = [
  {
    title: "Learn Everything",
    description:
      "用 Astro 和 Markdown 搭建的个人数字花园，用来沉淀学习、项目与思考。",
    tags: ["Astro", "Markdown", "数字花园"],
    href: "https://github.com/bailixisu/learn-everything",
    status: "持续更新",
  },
  {
    title: "下一个项目",
    description: "正在实践中的作品会出现在这里：问题、技术选择、阶段结论。",
    tags: ["Coming soon"],
    href: "#",
    status: "等待记录",
  },
];
---

<Layout
  title={`${t.nav.projects} · ${config.site.title}`}
  description="bailixisu 的项目实践与作品。"
>
  <Header />
  <main id="main-content" class="app-layout py-10 sm:py-14">
    <header class="border-border/80 mb-10 border-b pb-8">
      <p
        class="text-accent mb-3 text-xs font-semibold tracking-[0.22em] uppercase"
      >
        Build in practice
      </p>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {t.nav.projects}
      </h1>
      <p
        class="text-muted-foreground mt-4 max-w-2xl text-base leading-7 sm:text-lg"
      >
        不只展示结果，也记录问题、选择与复盘。
      </p>
    </header>

    <div class="grid gap-5 sm:grid-cols-2">
      {
        projects.map(project => (
          <article class="post-surface-card surface-card p-6">
            <div class="mb-4 flex items-start justify-between gap-4">
              <h2 class="text-xl font-semibold tracking-tight">
                {project.title}
              </h2>
              <span class="text-accent bg-accent/10 shrink-0 rounded-full px-2.5 py-1 text-xs font-medium">
                {project.status}
              </span>
            </div>
            <p class="text-muted-foreground min-h-16 text-sm leading-7">
              {project.description}
            </p>
            <ul class="my-5 flex flex-wrap gap-2" aria-label="技术标签">
              {project.tags.map(tag => (
                <li class="border-border rounded-md border px-2 py-1 text-xs">
                  {tag}
                </li>
              ))}
            </ul>
            {project.href !== "#" && (
              <a
                class="text-accent text-sm font-medium underline decoration-dashed underline-offset-4"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                查看仓库 →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
