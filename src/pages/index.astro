---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import GardenFolioItem from "@/components/GardenFolioItem.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import config from "@/config";
import "@/styles/garden-home.css";

dayjs.extend(utc);
dayjs.extend(timezone);

const { socials, posts: postsConfig, site } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const nowPost = featuredPosts[0] ?? sortedPosts[0];
const grovePosts = sortedPosts
  .filter(post => post.id !== nowPost?.id)
  .slice(0, postsConfig.perIndex);

const homePath = getRelativeLocaleUrl(locale, "");
const rssBase = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const titleParts = site.title.trim().split(/\s+/);
const titlePrimary = titleParts[0] ?? site.title;
const titleSecondary = titleParts.slice(1).join(" ") || "";

function formatGardenDate(post: (typeof sortedPosts)[number]) {
  const { pubDatetime, modDatetime, timezone: postTz } = post.data;
  const stamp = dayjs(
    modDatetime && modDatetime > pubDatetime ? modDatetime : pubDatetime
  ).tz(postTz ?? config.site.timezone);
  return { label: stamp.format("YYYY年M月D日"), iso: stamp.toISOString() };
}

const nowMeta = nowPost ? formatGardenDate(nowPost) : null;
const nowUrl = nowPost
  ? getPostUrl(nowPost.id, nowPost.filePath, locale)
  : null;
---

<Layout>
  <Header chrome="garden" />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="garden-canvas"
  >
    <div class="garden-glow" aria-hidden="true"></div>

    <section
      class="garden-spread reveal-garden"
      data-reveal="pending"
      style="--reveal-delay: 0ms"
      aria-labelledby="garden-masthead"
    >
      <p class="garden-vertical garden-parallax" data-parallax="0.04">
        {t.home.mastheadMark}
      </p>

      <div class="garden-masthead" id="garden-masthead">
        <span class="garden-masthead-ghost garden-parallax" data-parallax="0.06"
          >{t.home.mastheadGhost}</span
        >
        <div class="garden-title-stack">
          <span class="garden-title-line">{titlePrimary}</span>
          {
            titleSecondary && (
              <span class="garden-title-line garden-title-line--shift">
                {titleSecondary}
              </span>
            )
          }
        </div>
        <p class="garden-hand">{t.home.mastheadSub}</p>
      </div>

      <div class="garden-lede">
        <p>{t.home.lead}</p>
        <p>{t.home.aside}</p>
      </div>

      <aside class="garden-whisper-wrap">
        <p class="garden-whisper-label">{t.home.whisperIntro}</p>
        <p class="garden-whisper">
          <a href={getRelativeLocaleUrl(locale, "posts")}>{t.nav.posts}</a>
          <span aria-hidden="true"> · </span>
          <a href={getRelativeLocaleUrl(locale, "tags")}>{t.nav.knowledge}</a>
          <span aria-hidden="true"> · </span>
          <a href={getRelativeLocaleUrl(locale, "projects")}>{t.nav.projects}</a
          >
          <span aria-hidden="true"> · </span>
          <a href={getRelativeLocaleUrl(locale, "about")}>{t.nav.about}</a>
          <span aria-hidden="true"> · </span>
          <a
            href={`${rssBase}rss.xml`}
            target="_blank"
            rel="noopener noreferrer">RSS</a
          >
        </p>
      </aside>

      {
        socials.length > 0 && (
          <div class="garden-social">
            <span>{t.home.socialLinks}</span>
            <Socials />
          </div>
        )
      }
    </section>

    <hr class="garden-rule" />

    {
      nowPost && nowUrl && (
        <section
          class="garden-chapter reveal-garden"
          data-reveal="pending"
          style="--reveal-delay: 120ms"
          aria-labelledby="chapter-now"
        >
          <header class="garden-chapter-head">
            <span class="garden-chapter-index" aria-hidden="true">
              壹
            </span>
            <h2 id="chapter-now" class="garden-chapter-title">
              {t.home.sectionNow}
            </h2>
            <p class="garden-chapter-epigraph">{t.home.sectionNowEpigraph}</p>
          </header>

          <article class="garden-now-spread">
            <a href={nowUrl} class="garden-now-link">
              <h3
                transition:name={toTransitionName(nowPost.id)}
                class="garden-now-title"
              >
                {nowPost.data.title}
              </h3>
              {nowPost.data.description && (
                <p class="garden-now-desc">{nowPost.data.description}</p>
              )}
              {nowMeta && (
                <p class="garden-now-meta">
                  <time datetime={nowMeta.iso}>{nowMeta.label}</time>
                </p>
              )}
            </a>
          </article>
        </section>
      )
    }

    {
      grovePosts.length > 0 && (
        <section
          class="garden-chapter reveal-garden"
          data-reveal="pending"
          style="--reveal-delay: 200ms"
          aria-labelledby="chapter-garden"
        >
          <header class="garden-chapter-head">
            <span class="garden-chapter-index" aria-hidden="true">
              贰
            </span>
            <h2 id="chapter-garden" class="garden-chapter-title">
              {t.home.sectionGarden}
            </h2>
            <p class="garden-chapter-epigraph">
              {t.home.sectionGardenEpigraph}
            </p>
          </header>

          <ol class="garden-folio">
            {grovePosts.map(data => (
              <GardenFolioItem
                heading="h3"
                readLabel={t.home.folioRead}
                {...data}
              />
            ))}
          </ol>
        </section>
      )
    }

    <section
      class="garden-chapter reveal-garden"
      data-reveal="pending"
      style="--reveal-delay: 280ms"
      aria-labelledby="chapter-notes"
    >
      <header class="garden-chapter-head">
        <span class="garden-chapter-index" aria-hidden="true">叁</span>
        <h2 id="chapter-notes" class="garden-chapter-title">
          {t.home.sectionNotes}
        </h2>
        <p class="garden-chapter-epigraph">{t.home.sectionNotesEpigraph}</p>
      </header>

      <p class="garden-notes-prose">
        {t.home.notesLine1}
        <a href={getRelativeLocaleUrl(locale, "posts")}>{t.nav.posts}</a>、
        <a href={getRelativeLocaleUrl(locale, "tags")}>{t.nav.knowledge}</a>
        {t.home.notesLine2}
        <a href={getRelativeLocaleUrl(locale, "projects")}>{t.nav.projects}</a>
        {t.home.notesLine3}
        <a href={getRelativeLocaleUrl(locale, "about")}>{t.nav.about}</a>。
      </p>

      <a class="garden-continuum" href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.continuum}
      </a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<script>
  import "@/scripts/garden-atmosphere";
</script>
