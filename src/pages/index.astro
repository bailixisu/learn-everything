---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import HubTile from "@/components/HubTile.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig, site } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const rssBase = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-10"
  >
    <section
      id="hero"
      class="hero-ambient motion-fade-up border-border/70 relative -mx-4 overflow-hidden border-b px-4 pt-10 pb-10 sm:-mx-6 sm:px-6 sm:pt-14 sm:pb-12"
      style="--motion-delay: 0ms"
    >
      <div class="relative z-[1] max-w-2xl">
        <p
          class="text-accent text-xs font-semibold tracking-[0.22em] uppercase sm:text-sm"
        >
          {t.home.eyebrow}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <h1
            class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl"
          >
            {site.title}
          </h1>
          <a
            target="_blank"
            href={`${rssBase}rss.xml`}
            class="text-muted-foreground hover:text-accent inline-flex items-center gap-1 rounded-full border border-dashed px-2.5 py-1 text-xs transition-colors"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss width={16} height={16} class="stroke-current stroke-2" />
            <span>RSS</span>
          </a>
        </div>
        <p class="mt-5 max-w-xl text-lg leading-8">{t.home.lead}</p>
        <p
          class="text-muted-foreground mt-3 max-w-xl text-sm leading-7 sm:text-base"
        >
          {t.home.aside}
        </p>
        {
          socials.length > 0 && (
            <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center">
              <span class="text-muted-foreground text-sm">
                {t.home.socialLinks}
              </span>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <section
      id="explore"
      class="reveal-section pt-12 sm:pt-14"
      style="--reveal-delay: 40ms"
      data-reveal="pending"
    >
      <SectionHeading title={t.home.exploreTitle} hint={t.home.exploreDesc} />
      <div class="grid gap-4 sm:grid-cols-2">
        <HubTile
          href={getRelativeLocaleUrl(locale, "posts")}
          title={t.home.hubPostsTitle}
          description={t.home.hubPostsDesc}
        />
        <HubTile
          href={getRelativeLocaleUrl(locale, "tags")}
          title={t.home.hubTagsTitle}
          description={t.home.hubTagsDesc}
        />
        <HubTile
          href={getRelativeLocaleUrl(locale, "projects")}
          title={t.home.hubProjectsTitle}
          description={t.home.hubProjectsDesc}
        />
        <HubTile
          href={getRelativeLocaleUrl(locale, "about")}
          title={t.home.hubAboutTitle}
          description={t.home.hubAboutDesc}
        />
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class="reveal-section pt-14"
          style="--reveal-delay: 80ms"
          data-reveal="pending"
        >
          <SectionHeading title={t.home.featured} hint={t.home.featuredHint} />
          <ul class="grid gap-4">
            {featuredPosts.map(data => (
              <Card variant="h3" presentation="surface" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section
          id="recent-posts"
          class="reveal-section pt-14"
          style="--reveal-delay: 120ms"
          data-reveal="pending"
        >
          <SectionHeading title={t.home.recentPosts} hint={t.home.recentHint} />
          <ul class="grid gap-4 sm:grid-cols-2">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" presentation="surface" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="reveal-section mt-12 text-center" data-reveal="pending">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="text-accent border-border hover:bg-muted/40 inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition-colors"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
